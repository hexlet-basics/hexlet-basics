# Copy to .env (make setup does this) and adjust for your machine.
# Values here mirror the built-in defaults; real environment variables win over
# anything set in .env. Keep secrets out of this file — it is committed.

# Go API (internal/config)
ADDR=:3001
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54330/code_basics_development

# Frontend (Vite, src/lib/api-client.ts)
VITE_API_URL=http://localhost:3001

# OpenTelemetry (optional). Uncomment to export traces to a local OTLP/HTTP
# collector; without OTEL_CONFIG_FILE the SDK is entirely disabled.
# OTEL_CONFIG_FILE=config/otel.yaml
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
