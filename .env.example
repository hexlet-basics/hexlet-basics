# Copy to .env (`mise run setup` does this) and adjust for your machine.
# Values here support local development; real environment variables win over
# anything set in .env. Keep production secrets out — this file is committed.

# Go API (internal/config)
# APP_ENV is development|production|test; .env is read only when it is unset or
# development. Required with no code default: DATABASE_URL, PUBLIC_URL, SITE_URL,
# APP_HOST, BLOB_BUCKET_URL (mise run dev sets them for the dev stack).
APP_ENV=development
ADDR=:3001
PUBLIC_URL=http://localhost:3001
APP_HOST=localhost
BLOB_BUCKET_URL=file://./storage?create_dir=true
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54330/code_basics_development
GUEST_COOKIE_SECRET=dev-insecure-guest-cookie-secret-change-me
EMAIL_TOKEN_SECRET=dev-insecure-email-token-secret-change-me
# Account email is written to the log unless a Postbox key is set; its links
# open SITE_URL.
SITE_URL=http://localhost:5173
MAIL_POSTBOX_ACCESS_KEY_ID=
MAIL_POSTBOX_SECRET_ACCESS_KEY=
AMOCRM_BASE_URL=
AMOCRM_AUTH_TOKEN=
YM_COUNTER=

# OAuth authorization server for MCP clients (ADR-0022), off by default. The
# issuer is the origin the browser reaches the SSR server on (the Vite proxy
# sends /oauth and the well-known documents on to Go); match your web port.
# OAUTH_ENABLED=true
# OAUTH_ISSUER=http://localhost:5173
# OAUTH_ENCRYPTION_KEY=dev-insecure-oauth-encryption-key-change-me
# Token lifetimes (defaults shown): access 1h, refresh 30 days.
# OAUTH_ACCESS_TOKEN_TTL=1h
# OAUTH_REFRESH_TOKEN_TTL=720h

# MCP endpoint at /mcp (ADR-0021), off by default. It accepts only OAuth tokens,
# so it needs the OAuth settings above.
# MCP_ENABLED=true
# Limits of the MCP tools; the values shown are the defaults. The rates are calls
# per MCP_RATE_WINDOW, in memory and per replica; the write and personal-data
# rates are for tools that do not exist yet.
# MCP_MAX_PAGE_SIZE=50
# MCP_MAX_RESPONSE_BYTES=102400
# MCP_TOOL_TIMEOUT=30s
# MCP_RATE_WINDOW=1m
# MCP_RATE_USER_CATALOGUE=60
# MCP_RATE_USER_PERSONAL=30
# MCP_RATE_USER_WRITE=10
# MCP_RATE_CLIENT_CATALOGUE=600
# MCP_RATE_CLIENT_PERSONAL=300
# MCP_RATE_CLIENT_WRITE=100

# OpenTelemetry (optional). Uncomment to export traces to a local OTLP/HTTP
# collector; without OTEL_CONFIG_FILE the SDK is entirely disabled.
# OTEL_CONFIG_FILE=config/otel.yaml
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
