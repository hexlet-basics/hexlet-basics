{
  "name": "hexlet-basics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate": "openapi-ts",
    "dev": "vite",
    "dev:all": "concurrently -k -n api,web -c blue,green \"air\" \"vite\"",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@mantine/core": "^9.4.2",
    "@mantine/hooks": "^9.4.2",
    "@tabler/icons-react": "^3.45.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "i18next": "^26.3.6",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "i18next-cli": "^1.67.3",
    "lefthook": "^2.1.10",
    "typescript": "~5.9.3",
    "vite": "^8.1.1"
  }
}
