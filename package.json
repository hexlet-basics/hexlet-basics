  "name": "hexlet-basics",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "openapi-ts",
    "spec": "tsp compile api-spec",
    "spec:watch": "tsp compile api-spec --watch",
    "dev": "vite dev",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "pnpm lint --fix",
    "format": "oxfmt",
    "format:check": "pnpm format --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
