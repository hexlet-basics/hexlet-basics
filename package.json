    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "size-limit": [
    {
      "name": "entry chunk (loaded on every page)",
      "path": "dist/client/assets/index-*.js",
      "limit": "320 kB",
      "gzip": true
    },
    {
      "name": "all client JavaScript, lazy chunks and the Monaco workers included",
      "path": "dist/client/assets/*.js",
      "limit": "5.5 MB",
      "gzip": true
    }
  ],
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
