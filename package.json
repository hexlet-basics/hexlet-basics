{
  "name": "hexlet-basics",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "openapi-ts",
    "spec": "tsp compile api-spec",
    "spec:watch": "tsp compile api-spec --watch",
    "dev": "vite dev",
    "dev:all": "concurrently -k -n api,worker,web -c blue,magenta,green \"air\" \"air -c .air.worker.toml\" \"vite dev\"",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "pnpm lint --fix",
    "format": "oxfmt",
    "format:check": "pnpm format --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@mantine/code-highlight": "^9.6.2",
    "@mantine/core": "^9.6.2",
    "@mantine/dates": "^9.6.2",
    "@mantine/hooks": "^9.6.2",
    "@mantine/modals": "^9.6.2",
    "@mantine/notifications": "^9.6.2",
    "@mantine/tiptap": "^9.6.2",
    "@monaco-editor/react": "^4.7.0",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.58",
    "@tanstack/react-table": "^9.2.4",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.2",
    "js-cookie": "^3.0.8",
    "mdast-util-directive": "^3.1.0",
    "monaco-editor": "^0.57.0",
    "motion": "^13.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@hey-api/openapi-ts": "0.0.0-next-20260824173136",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "@typespec/compiler": "1.16.0",
    "@typespec/http": "1.16.0",
    "@typespec/openapi": "1.16.0",
    "@typespec/openapi3": "1.16.0",
    "@typespec/rest": "0.86.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.1",
    "concurrently": "^10.0.5",
    "i18next-cli": "^1.74.1",
    "lefthook": "^2.1.14",
    "msw": "^2.15.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "vitest-browser-react": "^2.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
