{
  "name": "hexlet-basics",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "openapi-ts",
    "spec": "tsp compile api-spec",
    "spec:watch": "tsp compile api-spec --watch",
    "dev": "vite dev",
    "dev:all": "concurrently -k -n api,worker,web -c blue,magenta,green \"air\" \"air -c .air.worker.toml\" \"vite dev\"",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "lint": "oxlint",
    "lint:fix": "pnpm lint --fix",
    "format": "oxfmt",
    "format:check": "pnpm format --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/dates": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/modals": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "@mantine/tiptap": "^9.5.1",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.35",
    "@tanstack/react-table": "^9.0.0",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "axios": "^1.19.0",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.6",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typespec/compiler": "1.14.0",
    "@typespec/http": "1.14.0",
    "@typespec/openapi": "1.14.0",
    "@typespec/openapi3": "1.14.0",
    "@typespec/rest": "0.84.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "concurrently": "^10.0.4",
    "i18next-cli": "^1.67.4",
    "lefthook": "^2.1.10",
    "msw": "^2.15.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "playwright": "^1.62.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
