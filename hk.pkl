amends "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Config.pkl"

// Git hooks managed by hk (installed by `mise run setup`, and by mise's postinstall hook, via `hk install --mise`).
// Rails/legacy keeps its own hooks under legacy/.
hooks {
  ["pre-commit"] {
    steps {
      // Staged content only: the builtin scans the whole directory, ignored files included.
      ["gitleaks"] {
        check = "gitleaks git --staged --redact --no-banner"
      }
      // Fast checks on the staged files only; whole-project ones (tsc, knip,
      // govulncheck, go test) run in the pre-push hook and in CI.
      ["oxlint"] {
        glob = List("src/**/*.ts", "src/**/*.tsx")
        check = "pnpm exec oxlint --no-error-on-unmatched-pattern {{files}}"
        fix = "pnpm exec oxlint --fix --no-error-on-unmatched-pattern {{files}}"
      }
      ["oxfmt"] {
        glob = List("src/**/*.ts", "src/**/*.tsx", "api-spec/*.tsp", "*.json", "*.toml", ".github/**/*.yml")
        check = "pnpm exec oxfmt --check --no-error-on-unmatched-pattern {{files}}"
        fix = "pnpm exec oxfmt --no-error-on-unmatched-pattern {{files}}"
      }
      // golangci-lint needs whole packages, so it runs once, not per file.
      ["golangci-lint"] {
        glob = List("**/*.go")
        check = "scripts/heavy golangci-lint run"
        fix = "scripts/heavy golangci-lint run --fix"
        exclusive = true
      }
      ["typos"] {
        check = "typos --force-exclude {{files}}"
        fix = "typos --force-exclude --write-changes {{files}}"
      }
      ["shellcheck"] {
        glob = List("scripts/*.sh", "scripts/oneoff/*/*.sh")
        check = "shellcheck -x {{files}}"
      }
      ["zizmor"] {
        glob = List(".github/workflows/*.yml")
        check = "zizmor --no-progress {{files}}"
      }
      ["jactionlint"] {
        glob = List(".github/workflows/*.yml")
        check = "jactionlint {{files}}"
      }
      // Terraform under legacy/terraform: fmt and validate without the backend.
      ["terraform"] {
        glob = List("legacy/terraform/**/*.tf")
        check = "mise run lint:infra"
        exclusive = true
      }
      ["helm"] {
        glob = List("k8s/app-chart/**")
        check = "mise run lint:helm"
        exclusive = true
      }
    }
  }
  ["commit-msg"] {
    steps {
      // commitlint rather than hk's built-in conventional-commit check:
      // commitlint.config.js is the rule set release-please relies on.
      ["commitlint"] {
        check = "pnpm exec commitlint --edit {{commit_msg_file}}"
      }
    }
  }
  // Whole-project lint, not a changed-files run: `tsc -b` and golangci-lint
  // need the full program to type-check.
  ["pre-push"] {
    steps {
      ["lint-go"] {
        check = "mise run lint:go"
      }
      ["lint-web"] {
        check = "mise run lint:web"
      }
      ["lint-adr"] {
        check = "mise run lint:adr"
      }
      ["lint-packages"] {
        check = "mise run lint:packages"
      }
    }
  }
}
