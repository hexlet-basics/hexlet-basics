amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

// Git hooks managed by hk (installed by `mise run setup`, and by mise's postinstall hook, via `hk install --mise`).
// Rails/legacy keeps its own hooks under legacy/.
hooks {
  ["pre-commit"] {
    steps {
      // Staged content only: the builtin scans the whole directory, ignored files included.
      ["gitleaks"] {
        check = "gitleaks git --staged --redact --no-banner"
      }
    }
  }
  ["commit-msg"] {
    steps {
      // commitlint rather than hk's built-in conventional-commit check:
      // commitlint.config.js is the rule set release-please relies on.
      ["commitlint"] {
        check = "pnpm exec commitlint --edit {{commit_msg_file}}"
      }
    }
  }
  // Whole-project lint, not a changed-files run: `tsc -b` and golangci-lint
  // need the full program to type-check.
  ["pre-push"] {
    steps {
      ["lint-go"] {
        check = "mise run lint:go"
      }
      ["lint-web"] {
        check = "mise run lint:web"
      }
      ["lint-adr"] {
        check = "mise run lint:adr"
      }
    }
  }
}
