# Root ignore for the new stack. Go-centric root: Go project (go.mod, cmd/,
# internal/) + Vite/React frontend (package.json, vite.config.ts, index.html,
# src/) both live at the root. The legacy Rails app has its own legacy/.gitignore.

# Dependencies
node_modules/
.pnpm-store/
.npm-cache/
npm-cache/
vendor/

# Frontend build output
dist/
*.tsbuildinfo

# Go build output
/server
/bin/
/tmp/
*.exe

# Local fileblob asset storage (dev default BLOB_BUCKET_URL, ADR-0005)
/storage/

# Env
.env
.env.local

# OS / editor / tooling caches
.DS_Store
.claude/
.playwright-cli/
.ruby-lsp/
.tanstack/
stats.html
internal/amocrm/generated/.kiota.log

# NOTE: generated pipeline artifacts are intentionally tracked so contract
# changes are reviewable in diffs and reproducible without running generators:
#   api-spec/dist/openapi.yaml        (TypeSpec -> OpenAPI)
#   internal/api/api.gen.go           (server + models, from the OpenAPI)
#   src/client/**                     (hey-api TS client + TanStack Query hooks)

# Vitest browser-mode failure artifacts
.vitest-attachments/
**/__screenshots__/
