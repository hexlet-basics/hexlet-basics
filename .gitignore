# Go project (go.mod, cmd/, internal/) and Vite/React frontend (package.json,
# vite.config.ts, index.html, src/), both at the root.

# Terraform: provider cache, and the backend key and provider config it writes
.terraform/
terraform/*.tfvars
terraform/*.json

# Dependencies
node_modules/
.pnpm-store/
.npm-cache/
npm-cache/
vendor/

# Frontend build output
dist/
*.tsbuildinfo

# Go build output
/server
/bin/
/tmp/
*.exe

# End-to-end suite: the frontend build it serves, Playwright output, and the API's blob dir
/e2e/.build/
/e2e/.results/
/e2e/.report/
/e2e/.storage/

# Local fileblob asset storage (dev default BLOB_BUCKET_URL, ADR-0005)
/storage/

# Env
.env
.env.local
mise.local.toml

# OS / editor / tooling caches
.DS_Store
.claude/
.playwright-cli/
.ruby-lsp/
.tanstack/
.kube/
stats.html

# NOTE: generated pipeline artifacts are intentionally tracked so contract
# changes are reviewable in diffs and reproducible without running generators:
#   api-spec/dist/openapi.yaml        (TypeSpec -> OpenAPI)
#   internal/api/api.gen.go           (server + models, from the OpenAPI)
#   src/client/**                     (hey-api TS client + TanStack Query hooks)

# Vitest browser-mode failure artifacts
.vitest-attachments/
**/__screenshots__/
.vitest/

# vitest --coverage output
/coverage/

# go test -coverprofile output
/cover.out
.lycheecache
