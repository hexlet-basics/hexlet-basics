{{/*
auditsecret generates ent.AuditSecretFields: for each schema type, the names
of its fields declared Sensitive() in the ent schema. internal/audit reads it so
that an Audit Record keeps only the name of such a field, never its old or new
value. Reusing ent's own Sensitive() marker (which already keeps the value out
of String() and logs) means one marker for "this is secret", not two that can
disagree; it is generated, not listed by hand, so a new secret field is covered
the moment it is marked.
*/}}

{{ define "auditsecret" }}

{{ template "header" $ }}

// AuditSecretFields maps an ent type name (Mutation.Type) to the names of its
// Sensitive() fields.
var AuditSecretFields = map[string][]string{
{{- range $n := $.Nodes }}
	{{- $secret := false }}
	{{- range $f := $n.Fields }}{{ if $f.Sensitive }}{{ $secret = true }}{{ end }}{{ end }}
	{{- if $secret }}
	{{ printf "%q" $n.Name }}: {
		{{- range $f := $n.Fields }}{{ if $f.Sensitive }}
		{{ printf "%q" $f.Name }},
		{{- end }}{{ end }}
	},
	{{- end }}
{{- end }}
}

{{ end }}
