{{/*
statemove generates Move<Field> on the client of every schema with a field
annotated schema.StateMove (see ent/schema/annotations.go): the one writer of a
state column, shared by every resource that has a Publication State or a
Course Readiness (ADR-0029).
*/}}

{{ define "statemove" }}

{{ $pkg := base $.Config.Package }}
{{ template "header" $ }}

{{- $has := false }}
{{- range $n := $.Nodes }}{{ range $f := $n.Fields }}{{ if hasKey $f.Annotations "StateMove" }}{{ $has = true }}{{ end }}{{ end }}{{ end }}

{{ if $has }}
import (
	"context"

	"hexletbasics/internal/domain"
	"hexletbasics/internal/transition"
{{ range $n := $.Nodes }}{{ range $f := $n.Fields }}{{ if hasKey $f.Annotations "StateMove" }}
	"{{ $.Config.Package }}/{{ $n.Package }}"
{{- end }}{{ end }}{{ end }}
)
{{ end }}

{{ range $n := $.Nodes }}
{{- range $f := $n.Fields }}
{{- if hasKey $f.Annotations "StateMove" }}
{{- $client := printf "%sClient" $n.Name }}
{{- $method := printf "Move%s" $f.StructField }}

// {{ $method }} moves the {{ $n.Name }}'s {{ $f.Name }} by one transition. The
// update carries the condition (the current value is one the move starts
// from), so two moves racing on one row cannot both succeed and the Audit
// Record never claims a change that did not happen; it is an UpdateOne, so the
// audit hook records the old and the new value. A missing row is ent's
// not-found error and a move the current value does not allow a
// *transition.IllegalError, neither writing anything.
func (c *{{ $client }}) {{ $method }}(ctx context.Context, id {{ $n.ID.Type }}, move transition.Transition[{{ $f.Type }}]) error {
	// Two rounds: a refused update re-reads the value to say why, and a value
	// that moved into one this move starts from in between is tried once more.
	for range 2 {
		err := c.UpdateOneID(id).Where({{ $n.Package }}.{{ $f.StructField }}In(move.From...)).Set{{ $f.StructField }}(move.To).Exec(ctx)
		if !IsNotFound(err) {
			return err
		}

		row, err := c.Query().Where({{ $n.Package }}.ID(id)).Select({{ $n.Package }}.{{ $f.Constant }}).Only(ctx)
		if err != nil {
			return err
		}

		if err := move.Check(row.{{ $f.StructField }}); err != nil {
			return err
		}
	}

	return domain.ErrConflict
}
{{- end }}
{{- end }}
{{- end }}

{{ end }}
